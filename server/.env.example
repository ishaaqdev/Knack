# Copy to .env and fill in your own key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Fallback chain deliberately spans DIFFERENT upstream providers. The original
# chain was gemma-31b -> gemma-26b, but both are served by Google AI Studio, so
# when that provider rate-limited, the "fallback" failed identically. Providers
# below: Darkbloom, Nvidia, Google AI Studio, Nvidia.
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-30b-a3b:free

# Optional. GitHub's API allows 60 requests/hour unauthenticated, and one profile
# sync costs ~7. A classic PAT with no scopes (public data only) raises it to
# 5000/hour: https://github.com/settings/tokens
GITHUB_TOKEN=

PORT=5190
# Loopback only. Set to 0.0.0.0 only if you deliberately want the API on the LAN.
HOST=127.0.0.1
