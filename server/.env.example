# Copy to .env and fill in your own key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

OPENROUTER_MODEL=minimax/minimax-m2.7:free
# Verified live 2026-08-30. Ordered by observed latency, not size: the chain is
# walked in order under a per-request time budget, so a slow model that eventually
# answers is worse than a fast one that answers now. Both Gemmas 429 most of the day.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Optional. GitHub's API allows 60 requests/hour unauthenticated, and one profile
# sync costs ~7. A classic PAT with no scopes (public data only) raises it to
# 5000/hour: https://github.com/settings/tokens
GITHUB_TOKEN=

PORT=5190
# Loopback only. Set to 0.0.0.0 only if you deliberately want the API on the LAN.
HOST=127.0.0.1
